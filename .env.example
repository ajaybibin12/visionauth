# ==========================================
# VisionAuth Configuration
# ==========================================

# Application
APP_NAME=VisionAuth
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# Server
HOST=127.0.0.1
PORT=8000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=visionauth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/visionauth
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/visionauth_test
